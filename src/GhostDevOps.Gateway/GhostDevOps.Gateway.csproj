<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <!-- GitHub API client -->
    <PackageReference Include="Octokit"                     Version="13.0.1" />
    <!-- SignalR for real-time dashboard updates -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR" Version="1.1.0" />
    <!-- Kubernetes client for self-healing restarts -->
    <PackageReference Include="KubernetesClient"            Version="13.0.26" />
    <!-- EF Core in-memory for incident tracking (swap for real DB in prod) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.0" />
    <!-- Prometheus metrics -->
    <PackageReference Include="prometheus-net.AspNetCore"   Version="8.2.1" />
  </ItemGroup>
</Project>
